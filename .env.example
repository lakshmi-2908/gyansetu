# GEMINI_API_KEY: Fallback brain (e.g., gemini-2.5-flash-lite / gemini-3.7-flash)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# OPENROUTER_API_KEY: Primary brain
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Primary model name (defaults to nvidia/nemotron-3-ultra-550b-a55b:free)
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# Grounding / Retrieval Tunable Thresholds
SIMILARITY_THRESHOLD="0.18"
TOP_K_CHUNKS="4"

# APP_URL: The URL where this applet is hosted.
APP_URL=""
